# Global configuration
{
    on_demand_tls {
        ask http://host.docker.internal:8099/caddy-ask
        interval 2m
        burst 5
    }
}

# Main Meeseek Console, Leases API, and Omnigent Agent
{$OMNIGENT_PUBLIC_HOST} {
    # Meeseek Console and API
    handle /ops* {
        reverse_proxy host.docker.internal:8099
    }
    handle /leases* {
        reverse_proxy host.docker.internal:8099
    }
    handle /readyz* {
        reverse_proxy host.docker.internal:8099
    }
    handle /console* {
        reverse_proxy host.docker.internal:8099
    }
    handle /caddy-ask* {
        reverse_proxy host.docker.internal:8099
    }
    handle /environments* {
        reverse_proxy host.docker.internal:8099
    }

    # Omnigent Agent UI and API (everything else)
    handle {
        reverse_proxy omnigent:8000
    }
}

# Dynamic Preview Workspaces (e.g. p18001.8.234.68.172.sslip.io or p18001.preview.domain.com)
https:// {
    tls {
        on_demand
    }

    @preview {
        header_regexp host_match Host ^p(?P<port>18[0-9]{3})\.
    }

    handle @preview {
        header {
            X-Content-Type-Options nosniff
            X-Frame-Options SAMEORIGIN
            Referrer-Policy strict-origin-when-cross-origin
        }
        reverse_proxy host.docker.internal:{re.host_match.port}
    }

    handle {
        respond "Preview host not found or port invalid" 404
    }
}
