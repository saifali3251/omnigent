# Copy to .env and fill in, or generate via ../scripts/pull-env.sh.
# Whatever writes this file (a human, or pull-env.sh pulling from a cloud
# secret store) must produce something shaped exactly like this — the
# compose file and the provision scripts both assume these exact names.

# ── accounts auth (Omnigent's own login for AI Builder Cup Hackathon) ──────
OMNIGENT_AUTH_PROVIDER=accounts
OMNIGENT_ACCOUNTS_ENABLED=1
OMNIGENT_ACCOUNTS_COOKIE_SECRET=   # openssl rand -hex 32
# EC2/GCE (via provision-omnigent-*.sh): https://<ip>.sslip.io
# Local Docker Desktop: http://localhost:8000 (plain http is fine for local —
# AccountsConfig only requires https for the __Host- secure-cookie prefix,
# which local dev deliberately skips)
OMNIGENT_ACCOUNTS_BASE_URL=http://localhost:8000
# Deliberately no OMNIGENT_ACCOUNTS_INIT_ADMIN_* here — first visit to the
# URL shows a Create-admin web form when no admin exists yet. Simpler than
# managing another secret.

# ── sandbox provider (whichever harness's wheel is in ../wheels/ —
#    today, Holodeck's) ─────────────────────────────────────────────────
OMNIGENT_SANDBOX_PROVIDER=holodeck
# REQUIRED even for a UI-only local smoke test — sitecustomize.py validates
# this at server BOOT (parse_sandbox_config), not lazily when a session
# launches, so an empty value crashes the container before it serves
# anything. EC2/GCE: filled in by provision-omnigent-*.sh. Local: any
# non-empty URL works (e.g. http://localhost:8000) since no real workspace
# will actually dial back to it in a UI-only test.
OMNIGENT_SANDBOX_SERVER_URL=
HOLODECK_URL=http://localhost:8099 # the control-plane process, wherever it runs
HOLODECK_APP=full-stack-application
HOLODECK_EXEC_SERVICE=backend

# ── model ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── local postgres (this box/laptop only — not RDS/Cloud SQL) ──────────
POSTGRES_PASSWORD=1234

# ── set by provision-omnigent-*.sh on EC2/GCE; leave blank for local ───
OMNIGENT_PUBLIC_HOST=
